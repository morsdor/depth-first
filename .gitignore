.env
.env.*
!.env.example
__pycache__/
assets_manifest.json
.venv/
prompts.md
anim_jobs.json
.DS_Store

# Vendored Real-ESRGAN upscaler (binary + weights, ~76MB, re-downloadable — see docs/upscaling.md)
tools/realesrgan/

# Generated & large media — regenerable. Git tracks the pipeline (code, prompts,
# storyboards, docs), not its heavy outputs. Hand-curated INPUT media stays tracked:
#   projects/*/references/  = accuracy-gate ground truth (small, curated, hard to reproduce)
#   assets/style_anchors/   = brand look anchors
*.mp4
*.mov
*.webm
*.mkv
*.avi
projects/*/images/
projects/*/images_4k/
projects/*/clips/
projects/*/videos/
projects/*/review/

# Remotion (the compositor since 2026-08-17). Track the source — src/, config, package.json —
# never the installed deps, bundle output or renders.
node_modules/
remotion/out/
remotion/build/
remotion/.remotion/

# Vendored third-party Agent Skills — installer output, NOT our source.
# `skills-lock.json` is the manifest (source + path + hash per skill) and IS tracked;
# restore a clone with:  npx skills experimental_install
# (.agents/ has never been tracked at HEAD — this just stops it showing as noise.)
.agents/
# The installer also symlinks each vendored skill into .claude/skills/.
# Our OWN hand-written skills there stay tracked — hence the negation.
.claude/skills/remotion-*
!.claude/skills/remotion-director/

# r004 working images — regenerated by projects/r004_jpeg/dct.py from the source photo
remotion/public/reels/r004_*.png
